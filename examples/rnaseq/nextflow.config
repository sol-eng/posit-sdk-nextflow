plugins {
    id 'nf-workbench@0.4.0'
}

process {
    executor = 'workbench'

    // Every process in main.nf declares its own biocontainers image; this is only a fallback.
    container = params.workbenchContainer ?: 'python:3.12-slim'

    // Resources per label. Keep these within the cluster's limits -- list them with
    // Client().compute_envs.list()['clusters'][*]['resourceLimits'] (maxValue).
    withLabel: 'single_core' {
        cpus   = 1
        memory = '1 GB'
    }
    withLabel: 'multi_core' {
        cpus   = 2
        memory = '2 GB'
    }
}

workbench {
    cluster         = params.workbenchCluster ?: 'Kubernetes'
    resourceProfile = params.workbenchResourceProfile ?: null
}

// Generic executor options go directly in the `executor` scope. (`executor.$workbench.*` is
// also honoured at runtime, but Nextflow 25.10's config validator warns about every
// `executor.$<name>.*` option -- even for built-in executors like `$slurm`.)
executor {
    // Maximum number of Workbench Jobs submitted at once. 10 is enough to run every
    // per-sample task of the default 4-sample run in parallel. Lower it to throttle.
    queueSize = params.workbenchQueueSize ?: 10

    // Each `status` call lists every job visible to the credential -- don't poll too often.
    queueStatInterval = '15 sec'
}

// Execution reports: timeline.html makes the parallelism visible (overlapping task bars).
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir ?: 'results'}/pipeline_info/timeline.html"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir ?: 'results'}/pipeline_info/report.html"
}
trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir ?: 'results'}/pipeline_info/trace.txt"
    fields    = 'task_id,name,status,submit,start,complete,duration,realtime,cpus,memory,native_id'
}
