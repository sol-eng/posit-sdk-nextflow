plugins {
    id 'nf-workbench@0.4.0'
}

process {
    executor = 'workbench'

    // Default image for processes that don't declare their own `container` (e.g. sum_squares).
    // Required on Kubernetes clusters, which reject jobs submitted without a container.
    container = params.workbenchContainer ?: 'python:3.12-slim'
}

// The plugin's own config scope (declared by the plugin, so Nextflow validates these options).
workbench {
    // Required: a valid Workbench compute env/cluster name, e.g. from Workbench's Jobs UI or
    // `posit-workbench-nf-launcher clusters`.
    cluster = params.workbenchCluster ?: 'Kubernetes'

    // Optional: Workbench resource profile for every task (the cluster's default if unset).
    // A single process can override it with `ext.resourceProfile = '...'`.
    resourceProfile = params.workbenchResourceProfile ?: null
}

// Generic grid-executor options (queueSize, pollInterval, queueStatInterval, ...) still go in
// the executor scope, e.g.:
// executor {
//     queueSize = 20
// }

profiles {
    // Run from inside a Positron or RStudio Pro Workbench session -- no credentials to set,
    // the launcher CLI picks up the ambient session cookie automatically.
    interactive {
    }

    // Run headlessly: either drive `nextflow run` from any host with WORKBENCH_SERVER/
    // WORKBENCH_API_KEY set, or submit the whole `nextflow run` invocation itself as a
    // Workbench Job via the Workbench API (see the repo root README).
    headless {
    }
}
